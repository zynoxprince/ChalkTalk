# Copy to .env.local and fill in. Never commit real keys.

# Required: OpenRouter API key (https://openrouter.ai/keys). Every model, voices
# included, is called through OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Models (any OpenRouter model ids)
LESSON_MODEL=google/gemini-4-hydrogen
TUTOR_MODEL=google/gemini-4-hydrogen
# Preferred OpenRouter endpoints for those models, in order (others stay as fallbacks).
# Google models default to google-ai-studio, the fastest in our tests; "auto" lets OpenRouter choose.
# MODEL_PROVIDERS=google-ai-studio
# Narrator: an OpenRouter text-to-speech model (google/gemini-3.8-flash-lite-tts is faster)
TTS_MODEL=google/gemini-3.8-flash-tts
TTS_VOICE=Sulafat
# Backup voice, used if the narrator fails ("none" turns it off)
BACKUP_TTS_MODEL=openai/gpt-audio-mini
BACKUP_TTS_VOICE=marin

# Required: random secret used to sign narration text for the speech endpoint.
# Generate one with: openssl rand -hex 32
SIGNING_SECRET=replace-with-a-long-random-string
